{
  "dialogue_id": "prologue_p04_security",
  "lines": [
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "이건 독립망이야. 밖에서 원본이 안 보인 이유는 알겠네."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "그날 기록도 있어?"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "목록에는 있는데 열리지 않아. 보관 서버가 지하에 있어."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "여기서 지워진 거야?"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "아직 몰라. 원본부터 확인하자."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "계단은?"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "기계식 봉쇄문. 이건 단말로 못 열어."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "determined",
      "text": "그럼 내가 할게."
    }
  ]
}
