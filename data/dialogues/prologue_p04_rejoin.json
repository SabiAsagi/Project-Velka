{
  "dialogue_id": "prologue_p04_rejoin",
  "lines": [
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "왔어."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "오는 길에 아무도 안 깼지?"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "다들 바닥에서 자고 있던데. 샤무 덕분에."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "빨리 찾고 나가자. 여기 공기가 이상해."
    }
  ]
}