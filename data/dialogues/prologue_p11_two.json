{
  "dialogue_id": "prologue_p11_two",
  "lines": [
    {
      "speaker": "system",
      "speaker_name": "",
      "sabi_emotion": "neutral",
      "shamu_emotion": "neutral",
      "text": "임시 숙소. 샤무는 장비를 정리하고, 사비는 의뢰인이 맡긴 사진을 보고 있다."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "그 사진 아직 보고 있어?"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "엉. 찾을 때 알아봐야 하니까."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "기록에 없다고 했잖아."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "determined",
      "shamu_emotion": "neutral",
      "text": "아직 못 찾았다고 했어."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "neutral",
      "text": "……그래. 아직은."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "밖에서 기다리는 사람도 있고."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "우리도 나갈 방법부터 찾아야 해."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "gentle_smile",
      "shamu_emotion": "neutral",
      "text": "웅. 같이."
    },
    {
      "speaker": "system",
      "speaker_name": "",
      "sabi_emotion": "neutral",
      "shamu_emotion": "neutral",
      "text": "사비가 샤무의 붕대를 바라본다."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "worried",
      "shamu_emotion": "neutral",
      "text": "너도 다쳤잖아."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "worried",
      "shamu_emotion": "annoyed",
      "text": "누구 때문에."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "sad",
      "shamu_emotion": "annoyed",
      "text": "미안해.."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "sad",
      "shamu_emotion": "serious",
      "text": "미안하다고 하지 말고 다음부터 대신 맞지 마."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "sad",
      "shamu_emotion": "serious",
      "text": "샤무도."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "sad",
      "shamu_emotion": "neutral",
      "text": "난 원래 그런 역할이야."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "나도 너 다치는 건 싫어."
    },
    {
      "speaker": "system",
      "speaker_name": "",
      "sabi_emotion": "serious",
      "shamu_emotion": "sad",
      "text": "샤무가 잠시 대답하지 않는다."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "serious",
      "shamu_emotion": "sad",
      "text": "……그러니까 둘 다 안 다치는 방법을 찾자고."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "gentle_smile",
      "shamu_emotion": "sad",
      "text": "웅."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "gentle_smile",
      "shamu_emotion": "serious",
      "text": "그리고 아까처럼 못 죽이는 거한테 막 덤비지 마."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "그건 샤무가 했는데."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "annoyed",
      "text": "시끄러."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "gentle_smile",
      "shamu_emotion": "annoyed",
      "text": "밥오."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "gentle_smile",
      "shamu_emotion": "cheerful_grin",
      "text": "누구더러 밥오래. 제일 밥오가."
    }
  ]
}
