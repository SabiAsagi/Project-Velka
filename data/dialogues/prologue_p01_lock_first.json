    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "장부 확보. 서버 사본도 가져갈게. 복사 끝날 때까지만 잡아 줘.",
      "cue": "server_plug"
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "이미 잡고 있어. 천천히 해.",
      "cue": "shamu_hold"
