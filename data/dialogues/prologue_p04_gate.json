{
  "dialogue_id": "prologue_p04_gate",
  "lines": [
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "열어써."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "이번엔 빨랐네."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "안에 경비가 둘. 손전등 비추는 쪽이 보는 방향이야. 안은 깜깜해서 빛 밖은 못 봐."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "들키면 그걸로 끝이야. 경비를 다 재우면 나도 들어갈게."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "그러니까 빨리 재우라는 거네."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "엉. 무전 켜 둘게. 다녀와."
    }
  ]
}