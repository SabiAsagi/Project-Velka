{
  "dialogue_id": "prologue_p04_forced_gate",
  "lines": [
    {
      "speaker": "system",
      "speaker_name": "",
      "text": "[shake rate=20.0 level=6][color=#ff6050]─── 사이렌 ───[/color][/shake]",
      "shake": true
    },
    {
      "speaker": "system",
      "speaker_name": "",
      "text": "금속이 찢어지는 소리에 이어, 공장 전체에 사이렌이 울린다. 안쪽에서 발소리가 늘어난다."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "……샤무.",
      "sabi_emotion": "serious"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "경비가 늘었어. 다들 문 쪽으로 올 거야. 들키면 그걸로 끝이야."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "문이 뜯겼으니 나도 같이 들어갈게. 경보가 보안 업체로 넘어가기 전에 지하 경보 장치부터 꺼야 해. 서두르자."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "serious",
      "shamu_emotion": "serious",
      "text": "빨리 끝내자. 붙어 있어."
    }
  ]
}
