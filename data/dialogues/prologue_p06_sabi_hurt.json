{
  "dialogue_id": "prologue_p06_sabi_hurt",
  "lines": [
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "sad",
      "shamu_emotion": "surprised",
      "text": "[shake rate=25.0 level=10]사비!![/shake]",
      "shake": true
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "sad",
      "shamu_emotion": "serious",
      "text": "…샤무, 공격 멈춰. 공격할수록 빨라져."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "sad",
      "shamu_emotion": "annoyed",
      "text": "안 죽으면 움직이지 못하게 하면 돼."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "worried",
      "shamu_emotion": "annoyed",
      "text": "샤무, 그만해."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "worried",
      "shamu_emotion": "annoyed",
      "text": "조용히 해."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "sad",
      "shamu_emotion": "annoyed",
      "text": "못 죽여."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "sad",
      "shamu_emotion": "determined",
      "text": "그럼 네 앞에 못 오게 할 거야."
    }
  ]
}