{
  "dialogue_id": "prologue_p04_basement",
  "lines": [
    {
      "speaker": "system",
      "speaker_name": "",
      "text": "[shake rate=20.0 level=6][color=#ff6050]─── 경보음 ───[/color][/shake]",
      "shake": true
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "경보가 울렸어. 아래층에서 자료를 지우기 시작했어!",
      "radio": true
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "둘 다 막아야 해?"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "응. 경보실 경보 장치에 중계기 꽂아. 그건 내가 끌게. 파쇄기는 네가 부숴.",
      "radio": true
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "몸이 두 개였으면 좋겠네."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "하나로도 충분해.",
      "radio": true
    }
  ]
}