{
  "dialogue_id": "c1_rulebook",
  "lines": [
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "이러면 여기 있는 누군가는 읽겠지."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "진짜 사람이라면."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "진짜 사람이라면."
    },
    {
      "speaker": "system",
      "speaker_name": "",
      "text": "[주요 임무]\n✓ 생존자용 안전수칙서 배치 (본관 1층)\n· 협회 학교 규칙 재확인  · 신규 전이자 수색\n· 변질된 규칙 기록  · 세 번째 종 이후 정문으로 이탈"
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "하나 했다."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "다섯 개 중에 하나."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "넌 꼭 그렇게 말해야 돼?"
    },
    {
      "speaker": "system",
      "speaker_name": "",
      "text": "돌아서는 순간, 지나가던 학생 하나가 걸음을 멈추고 게시판 앞에 선다. 읽고 있는 것처럼. 하얀 얼굴이 아주 조금, 수칙서 쪽으로 기운다."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "……읽는 걸까.",
      "sabi_emotion": "serious"
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "text": "읽는 척하는 걸 수도 있고."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "text": "어느 쪽이든 확인해야 돼. 여기 있는 애들 중에 누가 진짜 사람인지."
    }
  ]
}