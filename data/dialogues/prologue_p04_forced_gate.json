{
  "dialogue_id": "prologue_p04_forced_gate",
  "lines": [
    {
      "speaker": "system",
      "speaker_name": "",
      "sabi_emotion": "neutral",
      "shamu_emotion": "neutral",
      "text": "[shake rate=20.0 level=6][color=#ff6050]─── 사이렌 ───[/color][/shake]",
      "shake": true
    },
    {
      "speaker": "system",
      "speaker_name": "",
      "sabi_emotion": "neutral",
      "shamu_emotion": "neutral",
      "text": "금속이 찢어지는 소리에 이어 사이렌이 울린다. 안쪽에서 발소리가 늘어난다."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "surprised",
      "shamu_emotion": "neutral",
      "text": "경보가 보안 업체 쪽으로 넘어가고 있어."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "neutral",
      "shamu_emotion": "serious",
      "text": "지금 들어와. 같이 이동하자."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "neutral",
      "text": "지하 경보 장치부터 끌게. 기록 볼 시간이 줄었어. 경비 눈에 띄면 끝이야."
    }
  ]
}
