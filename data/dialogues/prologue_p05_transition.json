{
  "dialogue_id": "prologue_p05_transition",
  "lines": [
    {
      "speaker": "system",
      "speaker_name": "",
      "sabi_emotion": "worried",
      "shamu_emotion": "serious",
      "text": "경보음도, 환풍기 소리도 멎었다. 손전등 불빛만 남았다."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "worried",
      "shamu_emotion": "serious",
      "text": "정전?"
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "serious",
      "shamu_emotion": "serious",
      "text": "아니."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "serious",
      "shamu_emotion": "surprised",
      "text": "뭐가 달라졌는데?"
    },
    {
      "speaker": "system",
      "speaker_name": "",
      "sabi_emotion": "neutral",
      "shamu_emotion": "neutral",
      "text": "사비가 위층으로 이어지는 계단을 올려다본다. 조금 전까지 들리던 경비원 무전 소리도, 서버실 팬 소리도 없다. 귀가 먹먹할 만큼 조용하다."
    },
    {
      "speaker": "sabi",
      "speaker_name": "사비 아사기",
      "sabi_emotion": "worried",
      "shamu_emotion": "surprised",
      "text": "사람들이 없어."
    },
    {
      "speaker": "shamu",
      "speaker_name": "카즈네 샤무",
      "sabi_emotion": "worried",
      "shamu_emotion": "determined",
      "text": "……일단 나가자. 왔던 길로."
    }
  ]
}
